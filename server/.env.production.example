# ---- Production config for the office intranet server ----
# Copy this file to `.env` on the server and fill in real values.

PORT=5000
NODE_ENV=production

# MongoDB (installed locally as a Windows service)
MONGODB_URI=mongodb://localhost:27017/vegam_revenue

# JWT — REQUIRED: replace with a long random secret (e.g. `openssl rand -hex 32`
# or in PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))).
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — not strictly needed in single-origin mode (Express serves the client),
# but set it to the URL users type in their browser.
CLIENT_URL=http://SERVER_HOSTNAME_OR_IP:5000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- One-time seed of the first admin (used by `npm run seed`) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@vegam.co
SEED_ADMIN_PASSWORD=CHANGE_ME_after_first_login
